{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splitkick",
  "mainBinaryName": "Splitkick",
  "version": "1.0.11",
  "identifier": "app.splitkick.desktop",
  "app": {
    "windows": [
      {
        "title": "Splitkick",
        "width": 800,
        "height": 600,
        "minWidth": 1000,
