{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splitkick",
  "version": "1.6.5",
  "identifier": "app.splitkick.desktop.dev",
  "build": {
    "beforeDevCommand": "bun run scripts/tauri-dev-before.mjs"
  },
  "bundle": {
    "icon": ["icons-fork/dev/icon.png", "icons-fork/dev/icon.icns"],
    "publisher": "Planetfall Software",
    "shortDescription": "Splitkick - local-first workbench for AI agents",
    "longDescription": "Splitkick is a local-first, cross-device workbench for AI coding agents: multi-project, multi-worktree, multi-session and multi-agent. Built on Jean by coolLabs.",
    "copyright": "© 2026 Planetfall Software. Built on Jean, © 2025 Andras Bacsai (Apache 2.0)."
  },
  "app": {
    "windows": [
      {
        "title": "Splitkick (Dev)",
        "width": 800,
        "height": 600,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        },
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["splitkick-dev"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/azeitler/splitkick/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMTM2MkMzMTJDQUFENzAKUldSd3Jjb1N3MklUMHh0amw2Q3F0QmhzUmFQVzV2OXhoQXV0S3pmb2RpTjJmdW9uYlUzN1oxYVIK"
    }
  }
}
